{
  "expo": {
    "name": "BorderMark",
    "slug": "BorderMark",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "bordermark",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bordermark.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BorderMark uses your location only when you choose to set your current country during onboarding or stay creation.",
        "NSFaceIDUsageDescription": "BorderMark uses Face ID to unlock the app when app lock is enabled.",
        "NSCameraUsageDescription": "BorderMark uses your camera only when you choose to take a photo for a stay.",
        "NSPhotoLibraryUsageDescription": "BorderMark uses your photo library only when you choose to attach photos to a stay."
      }
    },
    "android": {
      "package": "com.bordermark.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3E7C78"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BorderMark uses your location only when you choose to set your current country.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BorderMark uses Face ID to unlock the app when app lock is enabled."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BorderMark uses your photo library only when you choose to attach photos to a stay.",
          "cameraPermission": "BorderMark uses your camera only when you choose to take a photo for a stay."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33bdd5bb-8eb1-4c4b-ac8a-bf8d3f0fa91b"
      }
    },
    "owner": "eeshbaev95"
  }
}
