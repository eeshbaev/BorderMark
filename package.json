{
  "name": "bordermark",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android": "npm run start:metro",
    "start:android:clear": "npm run start:metro:clear",
    "start:metro": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo start --dev-client --port 8081",
    "start:metro:clear": "npm run metro:kill && REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo start --dev-client --port 8081 --clear",
    "metro:kill": "lsof -ti :8081 -ti :8082 | xargs kill -9 2>/dev/null || true",
    "android:emulator": "bash scripts/android-emulator.sh",
    "android:install": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android --no-bundler",
    "android:dev": "npm run android:install && npm run android:reconnect",
    "android:connect": "bash scripts/android-connect.sh",
    "android:reconnect": "npm run android:connect",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.20",
    "expo-constants": "^57.0.17",
    "expo-crypto": "^57.0.2",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.6",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "^57.0.9",
    "expo-local-authentication": "^57.0.2",
    "expo-location": "^57.0.16",
    "expo-notifications": "^57.0.17",
    "expo-router": "^57.0.19",
    "expo-secure-store": "^57.0.3",
    "expo-sharing": "^57.0.18",
    "expo-splash-screen": "^57.0.8",
    "expo-sqlite": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "hash-wasm": "^4.12.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-worklets": "^0.12.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.5.1",
    "babel-preset-expo": "~57.0.0",
    "jest": "^30.5.1",
    "jest-expo": "^57.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
